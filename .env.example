POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=newtonite
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/newtonite
SECRET_KEY=insecure-dev-secret-key-change-in-production-32-bytes!
APP_NAME=Operations Under Pressure
DEBUG=true
ENVIRONMENT=development
ACCESS_TOKEN_EXPIRE_MINUTES=60

VITE_API_BASE_URL=http://localhost:8000

# Load demo users/items on container start (refused unless ENVIRONMENT is development/dev/local/test).
SEED_DEMO_DATA=true
